{
  "name": "nitro-patcher",
  "version": "0.2.0",
  "description": "Native Node.js Nintendo DS ROM reader, repacker and ZIP/Xdelta patcher",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-only",
  "bin": {
    "nitro-patcher": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nitro-helper": {
      "types": "./dist/nitro-helper.d.ts",
      "import": "./dist/nitro-helper.js"
    },
    "./nitro-patch-helper": {
      "types": "./dist/nitro-patch-helper.d.ts",
      "import": "./dist/nitro-patch-helper.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "clean": "tsx scripts/clean.ts",
    "build": "pnpm run build:node && pnpm run build:browser",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "test:reference": "tsx scripts/verify-reference.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test && pnpm run build && pnpm run test:browser",
    "prepack": "pnpm run build",
    "test:package": "tsx scripts/verify-package.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:node": "tsup src/index.ts src/nitro-helper.ts src/nitro-patch-helper.ts src/cli.ts --format esm --platform node --target node22 --splitting --sourcemap --dts --clean",
    "build:browser": "tsx scripts/build-browser.ts",
    "test:browser": "tsx scripts/verify-browser.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xzonn/nitro-patcher.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "22.20.2",
    "buffer": "6.0.3",
    "esbuild": "0.28.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.3",
    "globals": "16.5.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "packageManager": "pnpm@11.3.0",
  "imports": {
    "#nitro-runtime": "./src/runtime/node.ts",
    "#browser-hashes": "@noble/hashes/legacy.js",
    "#browser-hmac": "@noble/hashes/hmac.js",
    "#browser-aes": "@noble/ciphers/aes.js"
  },
  "dependencies": {
    "markdansi": "0.3.3"
  }
}
